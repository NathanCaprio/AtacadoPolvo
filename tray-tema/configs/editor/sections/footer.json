      "static": true,
      "visible": true,
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Título",
          "default": ""
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "show_newsletter",
      "type": "checkbox",
      "label": "Exibir newsletter",
      "default": true
    },
    {
      "id": "newsletter_title",
      "type": "text",
      "label": "Título da newsletter",
