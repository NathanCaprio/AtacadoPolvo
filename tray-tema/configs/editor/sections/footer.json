{
  "name": "Rodapé",
  "limit": 1,
  "static": true,
  "template": "footer",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "polvo_footer_about",
      "name": "Polvo: marca, redes e grupo de ofertas",
      "template": "snippets/polvo_footer_about",
      "limit": 1,
      "settings": [
        {
          "id": "description",
          "type": "textarea",
          "label": "Frase abaixo da marca",
          "maxLength": 200
        },
        {
          "id": "group_text",
          "type": "text",
          "label": "Botão do grupo: texto",
          "maxLength": 40,
          "info": "Em branco = sem o botão. Instagram: Configurações do tema > Redes sociais."
        },
        {
          "id": "group_link",
          "type": "text",
          "label": "Botão do grupo: link do convite",
          "info": "https://chat.whatsapp.com/..."
        }
      ]
    },
    {
      "type": "polvo_footer_links",
      "name": "Polvo: coluna de links",
      "template": "snippets/polvo_footer_links",
      "limit": 3,
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Título",
          "maxLength": 30
        },
        {
          "id": "links",
          "type": "textarea",
          "label": "Links",
          "maxLength": 1500,
          "info": "Um por linha, no formato: Texto | /endereco"
        }
      ]
    },
    {
      "type": "polvo_footer_contact",
      "name": "Polvo: contato (endereço e horário)",
      "template": "snippets/polvo_footer_contact",
      "limit": 1,
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Título",
          "maxLength": 30
        },
        {
          "id": "address",
          "type": "textarea",
          "label": "Endereço",
          "maxLength": 200
        },
        {
          "id": "hours",
          "type": "textarea",
          "label": "Horário de atendimento",
          "maxLength": 150,
          "info": "Telefone e e-mail vêm dos dados da loja."
        }
      ]
    },
    {
      "type": "support",
      "name": "Suporte",
      "template": "snippets/support",
      "limit": 1,
      "static": true,
      "visible": true,
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Título",
          "default": "Central de atendimento"
        }
      ]
    },
    {
      "type": "pages",
      "name": "Institucional",
      "limit": 1,
      "static": true,
      "visible": true,
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Título",
          "default": "Institucional"
        }
      ]
    },
    {
      "type": "payment_security",
      "name": "Pagamento e Segurança",
      "limit": 1,
      "static": true,
      "visible": true,
      "settings": [
        {
          "id": "show_payment",
          "type": "checkbox",
          "label": "Exibir bloco pagamentos",
          "default": true
        },
        {
          "id": "payment_title",
          "type": "text",
          "label": "Título pagamentos",
          "default": "Pagamento"
        },
        {
          "type": "checkbox",
          "id": "show_security",
          "label": "Exibir bloco segurança",
          "default": true
        },
        {
          "id": "security_title",
          "type": "text",
          "label": "Título segurança",
          "default": "Segurança"
        }
      ]
    },
    {
      "type": "social_networks",
      "name": "Redes sociais",
      "limit": 1,
      "static": true,
      "visible": true,
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Título",
          "default": ""
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "show_newsletter",
      "type": "checkbox",
      "label": "Exibir newsletter",
      "default": true
    },
    {
      "id": "newsletter_title",
      "type": "text",
      "label": "Título da newsletter",
      "maxLength": 30,
      "default": "Newsletter"
    },
    {
      "id": "newsletter_subtitle",
      "type": "text",
      "label": "Subtítulo da newsletter",
      "maxLength": 40,
      "default": "Se inscreva na nossa newsletter"
    },
    {
      "id": "newsletter_button_text",
      "type": "text",
      "label": "Texto do botão da newsletter",
      "maxLength": 10,
      "default": "Acessar"
    },
    {
      "id": "polvo_copy",
      "type": "text",
      "label": "Linha final (depois de © ano)",
      "maxLength": 120,
      "default": "Atacado Polvo — CNPJ 00.000.000/0001-00",
      "info": "Vale só se a mensagem do rodapé (dados da loja) estiver vazia."
    }
  ]
}
