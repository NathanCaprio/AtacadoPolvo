# Banco de dados e arquivos do SQLite (WAL/SHM)
dados/

# Credenciais do servidor (usuário do ERP). Lido pelo npm start.
.env

# Artefatos do navegador controlado por ferramenta
.playwright-mcp/

# npm (o projeto não tem dependências, mas caso alguém instale algo)
node_modules/

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Cópias do banco e exports (contêm hash de senha dos clientes)
backups/

# ZIP do tema da Tray gerado por npm run tema-zip (sobe em Ações > Enviar tema)
tray-tema.zip

# LPs montadas por npm run lp (coladas no criador de LPs da Tray)
tray-tema/lp/dist/
